{
  "manifest_version": 3,
  "name": "ToyotaSureHub Auto Wall",
  "short_name": "TSH Auto Wall",
  "version": "1.1.1",
  "description": "Tự đăng bài Tường cá nhân và Hội nhóm (kèm chia sẻ thêm nhóm theo dòng xe) từ FB Queue của ToyotaSureHub, có giới hạn bài/ngày và giãn cách.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "ToyotaSureHub Auto Wall",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://www.facebook.com/*",
    "https://web.facebook.com/*"
  ]
}
